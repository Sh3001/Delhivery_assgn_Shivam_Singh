<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_mapping</name>
  <version>0.1.0</version>
  <description>
    Cooperative SLAM and map fusion for the AMR fleet: one slam_toolbox
    instance per robot, a selective-update filter on AMR-1's contribution
    (frontier priority, throttled updates on repeatedly-traversed cells),
    and a map-merge node that fuses both robots' maps into a single global
    occupancy grid.
  </description>
  <maintainer email="s1.shivam3001@gmail.com">Shivam</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>amr_core</exec_depend>
  <exec_depend>amr_navigation</exec_depend>

  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
