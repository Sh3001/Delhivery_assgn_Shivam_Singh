      <specular>0.25 0.25 0.25 1</specular>
      <attenuation><range>900</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.3 0.35 -0.9</direction>
    </light>

