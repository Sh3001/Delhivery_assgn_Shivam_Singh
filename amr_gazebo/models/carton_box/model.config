<?xml version="1.0"?>
<model>
  <name>carton_box</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Shivam</name>
    <email>s1.shivam3001@gmail.com</email>
  </author>
  <description>
    Simple cardboard shipping carton (primitive box, no mesh - cheap to tile
    dozens of across the warehouse). Static, sized to sit on top of a
    storage_rack module (0.906 x 0.305 x 0.775 m) without overhanging it.
    Used as set-dressing so the rack rows read as stocked shelving rather
    than bare steel frames.
  </description>
</model>
