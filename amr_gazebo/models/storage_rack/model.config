<?xml version="1.0"?>
<model>
  <name>storage_rack</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Shivam</name>
    <email>s1.shivam3001@gmail.com</email>
  </author>
  <description>
    4-shelf steel-frame utility rack, geometry sourced from the supplied
    SolidWorks STEP export ("Storage rack.STEP") - legs and shelf boards as
    separate meshes so they can carry distinct materials. Footprint
    0.906 x 0.305 m, height 0.775 m. Tiled repeatedly to build the
    warehouse's rack rows; collision is a single box for physics
    performance, sized to the mesh's bounding box.
  </description>
</model>
