<?xml version="1.0"?>
<model>
  <name>pallet_rack</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Shivam</name>
    <email>s1.shivam3001@gmail.com</email>
  </author>
  <description>
    Tall yellow pallet-racking bay (1.4 x 0.9 m footprint, 2.6 m high) built
    from primitives - the back-wall racking in the reference warehouse photo.
    Collision is one solid box per bay so a rack row reads as a wall to the
    costmap rather than a row of gaps between legs.
  </description>
</model>
