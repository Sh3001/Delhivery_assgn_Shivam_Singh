<?xml version="1.0" ?>
<!--
  Tall yellow pallet racking - the bays standing against the back wall in the
  reference warehouse photo. Built from primitives rather than a mesh so it
  stays cheap for physics and needs no external assets.

  Footprint 1.4 (x) x 0.9 (y), 2.6 m tall. Collision is a single box covering
  the whole bay: a 2D lidar at ~0.2 m only ever sees the uprights anyway, and
  one box keeps the costmap's view of a rack row solid instead of a dotted
  line of legs the planner would try to squeeze between.
-->
<sdf version="1.9">
  <model name="pallet_rack">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 1.3 0 0 0</pose>
        <geometry><box><size>1.4 0.9 2.6</size></box></geometry>
      </collision>

      <!-- four yellow corner uprights -->
      <visual name="upright_fl">
        <pose>0.65 0.4 1.3 0 0 0</pose>
        <geometry><box><size>0.1 0.1 2.6</size></box></geometry>
        <material><ambient>0.85 0.68 0.05 1</ambient><diffuse>0.95 0.76 0.08 1</diffuse></material>
      </visual>
      <visual name="upright_fr">
        <pose>0.65 -0.4 1.3 0 0 0</pose>
        <geometry><box><size>0.1 0.1 2.6</size></box></geometry>
        <material><ambient>0.85 0.68 0.05 1</ambient><diffuse>0.95 0.76 0.08 1</diffuse></material>
      </visual>
      <visual name="upright_rl">
        <pose>-0.65 0.4 1.3 0 0 0</pose>
        <geometry><box><size>0.1 0.1 2.6</size></box></geometry>
        <material><ambient>0.85 0.68 0.05 1</ambient><diffuse>0.95 0.76 0.08 1</diffuse></material>
      </visual>
      <visual name="upright_rr">
        <pose>-0.65 -0.4 1.3 0 0 0</pose>
        <geometry><box><size>0.1 0.1 2.6</size></box></geometry>
        <material><ambient>0.85 0.68 0.05 1</ambient><diffuse>0.95 0.76 0.08 1</diffuse></material>
      </visual>

      <!-- yellow load beams, front and back, at three levels -->
      <visual name="beam_f_0">
        <pose>0 0.4 0.75 0 0 0</pose>
        <geometry><box><size>1.42 0.08 0.12</size></box></geometry>
        <material><ambient>0.85 0.68 0.05 1</ambient><diffuse>0.95 0.76 0.08 1</diffuse></material>
      </visual>
      <visual name="beam_r_0">
        <pose>0 -0.4 0.75 0 0 0</pose>
        <geometry><box><size>1.42 0.08 0.12</size></box></geometry>
        <material><ambient>0.85 0.68 0.05 1</ambient><diffuse>0.95 0.76 0.08 1</diffuse></material>
      </visual>
      <visual name="beam_f_1">
        <pose>0 0.4 1.6 0 0 0</pose>
        <geometry><box><size>1.42 0.08 0.12</size></box></geometry>
        <material><ambient>0.85 0.68 0.05 1</ambient><diffuse>0.95 0.76 0.08 1</diffuse></material>
      </visual>
      <visual name="beam_r_1">
        <pose>0 -0.4 1.6 0 0 0</pose>
        <geometry><box><size>1.42 0.08 0.12</size></box></geometry>
        <material><ambient>0.85 0.68 0.05 1</ambient><diffuse>0.95 0.76 0.08 1</diffuse></material>
      </visual>
      <visual name="beam_f_2">
        <pose>0 0.4 2.45 0 0 0</pose>
        <geometry><box><size>1.42 0.08 0.12</size></box></geometry>
        <material><ambient>0.85 0.68 0.05 1</ambient><diffuse>0.95 0.76 0.08 1</diffuse></material>
      </visual>
      <visual name="beam_r_2">
        <pose>0 -0.4 2.45 0 0 0</pose>
        <geometry><box><size>1.42 0.08 0.12</size></box></geometry>
        <material><ambient>0.85 0.68 0.05 1</ambient><diffuse>0.95 0.76 0.08 1</diffuse></material>
      </visual>

      <!-- palletised goods sitting on the lower two levels. Kept clear of the
           beams in z so no two surfaces share a boundary plane. -->
      <visual name="load_0">
        <pose>0 0 1.03 0 0 0</pose>
        <geometry><box><size>1.15 0.72 0.44</size></box></geometry>
        <material><ambient>0.34 0.26 0.16 1</ambient><diffuse>0.38 0.29 0.18 1</diffuse></material>
      </visual>
      <visual name="load_1">
        <pose>0 0 1.88 0 0 0</pose>
        <geometry><box><size>1.15 0.72 0.44</size></box></geometry>
        <material><ambient>0.34 0.26 0.16 1</ambient><diffuse>0.38 0.29 0.18 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
