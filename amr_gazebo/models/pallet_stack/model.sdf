<?xml version="1.0" ?>
<!--
  A pallet carrying stacked cardboard cartons - the floor-stacked goods that
  fill the open bay in the reference warehouse photo.

  1.2 (x) x 1.0 (y), ~1.05 m tall. Every carton is inset slightly from its
  neighbours and from the pallet below, so no two visual surfaces ever share a
  boundary plane (coincident faces render as flickering strobe in ogre2).
-->
<sdf version="1.9">
  <model name="pallet_stack">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.525 0 0 0</pose>
        <geometry><box><size>1.2 1.0 1.05</size></box></geometry>
      </collision>

      <visual name="pallet">
        <pose>0 0 0.07 0 0 0</pose>
        <geometry><box><size>1.2 1.0 0.14</size></box></geometry>
        <material><ambient>0.42 0.31 0.17 1</ambient><diffuse>0.47 0.35 0.19 1</diffuse></material>
      </visual>

      <!-- lower course: two cartons side by side -->
      <visual name="box_l0">
        <pose>-0.29 0 0.37 0 0 0</pose>
        <geometry><box><size>0.56 0.92 0.44</size></box></geometry>
        <material><ambient>0.62 0.47 0.32 1</ambient><diffuse>0.68 0.52 0.35 1</diffuse></material>
      </visual>
      <visual name="box_r0">
        <pose>0.29 0 0.37 0 0 0</pose>
        <geometry><box><size>0.56 0.92 0.44</size></box></geometry>
        <material><ambient>0.60 0.45 0.30 1</ambient><diffuse>0.66 0.50 0.33 1</diffuse></material>
      </visual>

      <!-- upper course, rotated 90 deg the way real stacks are interlocked -->
      <visual name="box_l1">
        <pose>0 -0.26 0.81 0 0 0</pose>
        <geometry><box><size>1.10 0.48 0.42</size></box></geometry>
        <material><ambient>0.64 0.49 0.33 1</ambient><diffuse>0.70 0.54 0.36 1</diffuse></material>
      </visual>
      <visual name="box_r1">
        <pose>0 0.26 0.81 0 0 0</pose>
        <geometry><box><size>1.10 0.48 0.42</size></box></geometry>
        <material><ambient>0.58 0.44 0.29 1</ambient><diffuse>0.64 0.48 0.32 1</diffuse></material>
      </visual>

      <!-- packing-tape seams, inset so their faces sit strictly inside the
           cartons' own rather than coincident with them -->
      <visual name="tape_lower">
        <pose>0 0 0.592 0 0 0</pose>
        <geometry><box><size>1.14 0.10 0.008</size></box></geometry>
        <material><ambient>0.40 0.29 0.17 1</ambient><diffuse>0.44 0.32 0.19 1</diffuse></material>
      </visual>
      <visual name="tape_upper">
        <pose>0 0 1.022 0 0 0</pose>
        <geometry><box><size>0.10 0.94 0.008</size></box></geometry>
        <material><ambient>0.40 0.29 0.17 1</ambient><diffuse>0.44 0.32 0.19 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
