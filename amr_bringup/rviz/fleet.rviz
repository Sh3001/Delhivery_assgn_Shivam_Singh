Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /AMR-1 (heavy tugger)1
        - /AMR-2 (light scout)1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:

    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
      Color: 100; 100; 100
      Alpha: 0.3

    # The cooperatively fused map both robots contribute to.
    - Class: rviz_default_plugins/Map
      Name: Unified map (/global_map)
      Enabled: true
      Topic:
        Value: /global_map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.7

    # §8/§27: frontier cells AMR-1's selective-mapping policy is prioritising.
    # Yellow, per the spec's colour convention. These are the actual decision
    # input to the update policy, not a separate recomputation.
    - Class: rviz_default_plugins/MarkerArray
      Name: AMR-1 frontiers (yellow)
      Enabled: true
      Topic:
        Value: /amr1/frontiers
        Reliability Policy: Reliable

    # §27: ramp footprints the RampCostLayer penalises.
    - Class: rviz_default_plugins/MarkerArray
      Name: Ramp regions (orange)
      Enabled: true
      Topic:
        Value: /ramp_regions
        Durability Policy: Transient Local

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 1

    # ---------------------------------------------------------------- AMR-1
    # Global plan in solid green, local plan (what the controller is actually
    # tracking right now) in bright yellow. If the robot is following its
    # plan the yellow stub sits on the green line and slides along it; if it
    # is not, the two visibly diverge - which is the whole point of looking.
    - Class: rviz_common/Group
      Name: AMR-1 (heavy tugger)
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Path
          Name: AMR-1 global plan
          Enabled: true
          Topic:
            Value: /amr1/plan
            Reliability Policy: Reliable
          Color: 25; 255; 0
          Line Style: Lines
          Alpha: 1

        - Class: rviz_default_plugins/Path
          Name: AMR-1 local plan
          Enabled: true
          Topic:
            Value: /amr1/local_plan
            Reliability Policy: Reliable
          Color: 255; 255; 0
          Line Style: Billboards
          Line Width: 0.05
          Alpha: 1

        - Class: rviz_default_plugins/LaserScan
          Name: AMR-1 scan (validated)
          Enabled: true
          Topic:
            Value: /amr1/scan_validated
            Reliability Policy: Best Effort
          Size (m): 0.04
          Color: 0; 255; 127
          Color Transformer: FlatColor

        - Class: rviz_default_plugins/Map
          Name: AMR-1 local costmap
          Enabled: false
          Topic:
            Value: /amr1/local_costmap/costmap
            Durability Policy: Transient Local
          Color Scheme: costmap
          Alpha: 0.5

    # ---------------------------------------------------------------- AMR-2
    - Class: rviz_common/Group
      Name: AMR-2 (light scout)
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Path
          Name: AMR-2 global plan
          Enabled: true
          Topic:
            Value: /amr2/plan
            Reliability Policy: Reliable
          Color: 0; 170; 255
          Line Style: Lines
          Alpha: 1

        - Class: rviz_default_plugins/Path
          Name: AMR-2 local plan
          Enabled: true
          Topic:
            Value: /amr2/local_plan
            Reliability Policy: Reliable
          Color: 255; 85; 255
          Line Style: Billboards
          Line Width: 0.05
          Alpha: 1

        - Class: rviz_default_plugins/LaserScan
          Name: AMR-2 scan (validated)
          Enabled: true
          Topic:
            Value: /amr2/scan_validated
            Reliability Policy: Best Effort
          Size (m): 0.04
          Color: 0; 170; 255
          Color Transformer: FlatColor

        - Class: rviz_default_plugins/Map
          Name: AMR-2 local costmap
          Enabled: false
          Topic:
            Value: /amr2/local_costmap/costmap
            Durability Policy: Transient Local
          Color Scheme: costmap
          Alpha: 0.5

    # Global costmap off by default - it covers the whole 58 x 36 m grid and
    # hides the plans underneath it. Tick it on to see the ramp cost the
    # RampCostLayer stamps over the ramp footprints.
    - Class: rviz_default_plugins/Map
      Name: Global costmap (ramp cost visible)
      Enabled: false
      Topic:
        Value: /amr1/global_costmap/costmap
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.6

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 45
      Focal Point:
        X: -8
        Y: 0
        Z: 0
      Pitch: 1.2
      Yaw: 0.8
      Target Frame: map
    Saved: ~

Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
