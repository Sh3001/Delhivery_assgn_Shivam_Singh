<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_bringup</name>
  <version>1.0.0</version>
  <description>
    Top-level bring-up for the AMR fleet simulation. Single entry point that
    starts the warehouse world, spawns both robots and runs the dynamic
    obstacle field.
  </description>
  <maintainer email="s1.shivam3001@gmail.com">Shivam</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>amr_gazebo</exec_depend>
  <exec_depend>amr_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
