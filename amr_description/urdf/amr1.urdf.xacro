<?xml version="1.0"?>
<!--
  AMR-1 "Mapper/Lead": accurate global localization and path planning,
  higher payload capacity. Larger/heavier chassis, longer-range LiDAR for
  mapping, lower acceleration limits (befitting a heavier, load-bearing unit).
-->
<robot name="amr1" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find amr_description)/urdf/amr_macro.xacro"/>

  <xacro:arg name="robot_name" default="amr1"/>

  <xacro:amr_robot
    robot_name="$(arg robot_name)"
    robot_type="amr1"
    material_name="amr_orange"
    body_length="0.70" body_width="0.50" body_height="0.18"
    chassis_mass="60.0" payload_capacity_kg="150.0"
    wheel_radius="0.14" wheel_width="0.08"
    wheel_separation="0.62" wheel_base_x="-0.15" idler_base_x="0.20"
    max_linear_vel="0.8" max_linear_accel="0.4" max_angular_accel="1.2"
    lidar_range="25.0"/>
</robot>
